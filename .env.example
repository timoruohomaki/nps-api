# SQLite database file path INSIDE the container. Persisted via the nps-data
# volume (see docker-compose). Local `go run` ignores this and defaults to ./nps.db.
DB_PATH=/data/nps.db

# base64-encoded 32-byte AES-256 key. Encrypts the PII fields (comment, timezone)
# at rest. REQUIRED in production — if empty, those fields are stored UNENCRYPTED
# and a warning is logged. Generate with:  openssl rand -base64 32
# WARNING: losing this key makes all previously-encrypted comments unrecoverable.
FEEDBACK_ENC_KEY=

# Comma-separated accepted X-API-Key values for POST /nps/api/v1/feedback.
# Empty = endpoint is open (no key required). Turn on only after BOTH clients
# (rokdsk, idefinity) send a matching key. Health check is always open.
API_KEYS=

# Comma-separated CONSUMER keys for GET /nps/api/v1/feedback (analytics query,
# returns decrypted PII). Empty = read endpoint disabled (503). Keep distinct
# from API_KEYS. Generate: openssl rand -hex 24
READ_API_KEYS=

# Comma-separated values accepted for the `platform` field. Defaults to
# "macOS,Windows". Widen it when a non-desktop client (mobile, web) also submits.
ALLOWED_PLATFORMS=macOS,Windows

PORT=8081
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
